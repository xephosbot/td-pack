"""OpenSSL build rule for rules_foreign_cc.

OpenSSL uses its own ./Configure script (not CMake), so we use
configure_make() from rules_foreign_cc to build it from source.

Platform → OpenSSL target mapping:
  macOS   arm64   → darwin64-arm64-cc
  macOS   x86_64  → darwin64-x86_64-cc
  Linux   x86_64  → linux-x86_64
  Linux   aarch64 → linux-aarch64
  Windows x64     → VC-WIN64A       (requires MSVC + NASM)
  Windows arm64   → VC-WIN64-ARM    (requires MSVC cross-tools)
  Android arm64   → android-arm64
  Android armv7   → android-arm
  Android x86_64  → android-x86_64
  Android x86     → android-x86
  iOS     arm64   → ios64-cross
  iOS     sim-arm → iossimulator-xcrun  (+ arm64 target)
  iOS     sim-x86 → iossimulator-xcrun  (+ x86_64 target)
"""

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

# --- config_settings for combined OS + CPU selects ---
# Bazel's built-in constraint_values can't be combined in a single
# select() arm, so we define config_settings that match both.

# Desktop
config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "windows_x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

# Android
config_setting(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "android_armv7",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:armv7",
    ],
)

config_setting(
    name = "android_x86_64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "android_x86",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_32",
    ],
)

# iOS
config_setting(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "ios_x86_64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:x86_64",
    ],
)

configure_make(
    name = "openssl",
    configure_command = "Configure",
    configure_options = [
        "no-shared",
        "no-tests",
    ] + select({
        # Desktop
        ":macos_arm64": ["darwin64-arm64-cc"],
        ":macos_x86_64": ["darwin64-x86_64-cc"],
        ":linux_x86_64": ["linux-x86_64", "-fPIC"],
        ":linux_arm64": ["linux-aarch64", "-fPIC"],
        ":windows_x64": ["VC-WIN64A", "no-asm"],
        ":windows_arm64": ["VC-WIN64-ARM", "no-asm"],
        # Android — NDK sets CC/AR/etc. via the registered toolchain.
        ":android_arm64": ["android-arm64", "-D__ANDROID_API__=21"],
        ":android_armv7": ["android-arm", "-D__ANDROID_API__=21"],
        ":android_x86_64": ["android-x86_64", "-D__ANDROID_API__=21"],
        ":android_x86": ["android-x86", "-D__ANDROID_API__=21"],
        # iOS — built with Xcode clang via apple_support toolchain.
        ":ios_arm64": [
            "ios64-cross",
            "no-dso",
            "no-engine",
            "no-comp",
            "no-hw",
            "no-async",
        ],
        ":ios_x86_64": [
            "iossimulator-xcrun",
            "no-dso",
            "no-engine",
            "no-comp",
            "no-hw",
            "no-async",
        ],
    }),
    env = select({
        "@platforms//os:linux": {"AR": ""},
        "@platforms//os:android": {"ANDROID_NDK_ROOT": ""},
        "//conditions:default": {},
    }),
    lib_source = ":all_srcs",
    out_static_libs = select({
        "@platforms//os:windows": [
            "libssl.lib",
            "libcrypto.lib",
        ],
        "//conditions:default": [
            "libssl.a",
            "libcrypto.a",
        ],
    }),
    targets = [
        "",
        "install_sw",
    ],
    visibility = ["//visibility:public"],
)
